{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run db:generate:*)",
      "Bash(npm run db:migrate)",
      "Bash(npm run source:pazarama:import -- --dry-run)",
      "Bash(npm run catalog:publish -- --source=pazarama)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker ps:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npm run db:seed:*)",
      "Bash(npm run catalog:publish:*)",
      "Bash(npm run source:pazarama:fetch:*)",
      "Bash(npm run source:pazarama:import:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(bash scripts/go-live.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(npx tsx scripts/remove-demo-data.ts:*)",
      "Bash(docker stop mercek:*)",
      "Bash(docker rm:*)"
    ]
  }
}
