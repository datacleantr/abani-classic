# Yalnızca anahtar isimleri. Gerçek değerler ortam panelinden verilir; bu dosyaya yazılmaz.
NODE_ENV=
# Üretimde https:// ile başlamalı (kanonik URL, sitemap).
APP_URL=
DATABASE_URL=
# lax (varsayılan) | strict | none — none yalnızca çapraz kaynaklı iframe önizlemesi için.
SESSION_COOKIE_SAMESITE=

# Ödeme: boş/sandbox = yalnızca geliştirme; bank_transfer = havale/EFT (elle onay).
# iyzico / paytr / param adapter'ları sözleşme sonrası yazılacaktır.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BANK_NAME=

# Zamanlanmış görev kimlik doğrulaması (üretimde zorunlu, en az 24 karakter).
CRON_SECRET=

SHIPPING_PROVIDER=
SHIPPING_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_ANALYTICS_ID=
